rules_version = '2';

// Deny-all client-side access. This Worker talks to Firestore exclusively
// through the REST API using a service-account OAuth token (see
// worker/src/firestore/auth.ts) — that path is authenticated as the service
// account and bypasses Security Rules entirely (rules only govern requests
// made with a Firebase Auth user/client SDK credential, which this app
// never uses; there is no Firebase Auth anywhere in this system, only the
// existing custom JWT scheme). These rules exist purely as defense in
// depth: if a Firebase Web API key for this project ever leaked, this is
// what stops it from being used to read/write the database directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
