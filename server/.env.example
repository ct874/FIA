NODE_ENV=development
PORT=5000

# Number of reverse-proxy hops in front of this process to trust for
# X-Forwarded-For (Express's `trust proxy` setting). Render's edge is one
# hop — leave this at 1 unless you know your host adds more. Getting this
# wrong either makes every request look like it comes from the same IP
# (too low — this was the root cause of legitimate concurrent users seeing
# 429s) or lets a client spoof its own IP (too high).
TRUST_PROXY_HOPS=1

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=https://fia.ct-cb1.workers.dev/

# MongoDB
MONGO_URI=mongodb+srv://rjtechtop5_db_user:Glb0i8vnQYdyEH2j@cluster0.civ2e7s.mongodb.net/

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d
JWT_EXPIRES_IN_REMEMBER_ME=30d

# Default Super Admin (auto-created on server startup if it doesn't exist)
SUPER_ADMIN_LOGIN_ID=fia@admin.com
SUPER_ADMIN_PASSWORD=fia@123
