# Leave unset in production — the Cloudflare Worker serves the built SPA
# and the /api/* routes from the same origin (see worker/wrangler.jsonc),
# so src/utils/constants.js already defaults to the relative path `/api`
# when this var is absent. Only set this for local development, pointed at
# `wrangler dev`'s local port (see worker/README or docs/MIGRATION.md):
VITE_API_BASE_URL=http://127.0.0.1:8787/api
