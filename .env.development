# Loaded automatically by Vite when running `npm run dev` (and NOT when
# running `vite build`, i.e. this never leaks into production). Points the
# frontend at the local Cloudflare Worker started via `wrangler dev` / `npm
# run worker:dev` (see worker/README, docs/MIGRATION.md).
#
# `.env.local` (gitignored) still wins over this file if you need a
# different local port — see .env.example.
VITE_API_BASE_URL=http://127.0.0.1:8787/api
